# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TERRAVISION Environmental Platform Configuration
# MapLibre Vector Basemap Style URL (Carto Dark default)
VITE_MAP_STYLE_URL="https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json"

# API Base URL for Frontend client
VITE_API_BASE_URL="/api/v1"

# FastAPI Backend Configuration
FASTAPI_PORT="8000"
FASTAPI_HOST="0.0.0.0"

# OpenAQ API Key (strictly server-side, never exposed to client)
OPENAQ_API_KEY=""

# Copernicus Climate Data Store (CDS) Credentials (Strictly NOT_CONFIGURED without key)
CDS_API_URL="https://cds.climate.copernicus.eu/api/v2"
CDS_API_KEY=""

# NASA POWER API Endpoint
NASA_POWER_API_URL="https://power.larc.nasa.gov/api/temporal/hourly/point"

# PostgreSQL + PostGIS Connection String
# e.g. postgresql+asyncpg://terravision:terravision_secure_password@localhost:5432/terravision
DATABASE_URL="postgresql+asyncpg://terravision:terravision_secure_password@localhost:5432/terravision"

# Redis Cache URL
REDIS_URL="redis://localhost:6379/0"
